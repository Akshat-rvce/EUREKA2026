# Shared Firestore project used by server-side Firebase Admin SDK
FIREBASE_PROJECT_ID=eureka-2026-5aa2c

# Server-only Firebase Admin service account JSON, stored as one-line JSON.
# Keep this value private. Never commit a populated .env.local or paste it into chat.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Single shared admin login identity and password (server-only)
FIREBASE_OWNER_EMAIL=eureka26@rvce.edu.in
EUREKA_ADMIN_PASSWORD=
EUREKA_ADMIN_SESSION_SECRET=
