# Server-only Firebase Admin service account JSON, stored as one-line JSON.
# Keep this value private. Never commit a populated .env.local or paste it into chat.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Verified Firebase Auth email permitted to bootstrap the first owner profile.
FIREBASE_OWNER_EMAIL=akshatraj.ee24@rvce.edu.in
